# Neon Postgres — pooled endpoint for serverless runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ravia?sslmode=require"

# Neon Postgres — unpooled endpoint for `prisma migrate` / `prisma generate`
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/ravia?sslmode=require"

# Auth.js (NextAuth)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Local dev only; Vercel sets this automatically in production.
NEXTAUTH_URL="http://localhost:3000"

# Public app URL (used by client if needed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo seed credentials (used by /api/seed to create a farm + owner on first run)
SEED_EMAIL="owner@ravia.farm"
SEED_PASSWORD="ravia1234"
SEED_FARM_NAME="Ravia Farms"
